/*
*
*
    ###################################################################################
    # SAED 90NM Educational Design Kit.						      #
    #										      #
    # Logic Model.	                      					      #
    #										      #
    # Revision History:								      #
    #										      #
    # Rev.	date			what					      #
    # --------------------------------------------------------------------------------# 
    # 1.1       26/August/2011           Recharacterized Buffer and Inverter cells to #                                                               
    #                                   solve prunnig of these cells during CTS.      #
    #										      #
    # 1.2	14/September/2011       Fixed consistency issues among libraries.     #
    #										      #    
    # 1.3       30/September/2011        Recharacterized IBUFFX* cells to solve       #    
    #                                   prunnig of these cells during CTS.            #    
    #                                    Added  missing  "internal_power"  and        #    
    #                                   "cell_leakage_power" library attributes for   #
    #					ANTENNA,CLOAD1,BUSKP cells.   	              #    
    ###################################################################################
*
*
*/
library ("saed90nm_max") {
	define(driver_model,library,string);
	define(def_sim_opt,library,string);
	define(simulator,library,string);
	define(always_on,cell,string);
	define(clk_width,timing,string);
	technology("cmos");
	delay_model : "table_lookup";
	date : "2007 (INF CREATED ON 27-DEC-2007)";
	revision : "updated 30.Sep.2011";
	time_unit : "1ns";
	leakage_power_unit : "1pW";
	voltage_unit : "1V";
	pulling_resistance_unit : "1kohm";
	current_unit : "1uA";
	capacitive_load_unit(1.000000, \
	"ff");
	default_threshold_voltage_group : "saed90cell";
	input_threshold_pct_rise : 50.000000;
	output_threshold_pct_rise : 50.000000;
	input_threshold_pct_fall : 50.000000;
	output_threshold_pct_fall : 50.000000;
	slew_lower_threshold_pct_rise : 10.000000;
	slew_upper_threshold_pct_rise : 90.000000;
	slew_lower_threshold_pct_fall : 10.000000;
	slew_upper_threshold_pct_fall : 90.000000;
	slew_derate_from_library : 1.000000;
	default_inout_pin_cap : 0.000000;
	default_cell_leakage_power : 0.000000;
	default_input_pin_cap : 0.000000;
	default_output_pin_cap : 0.000000;
	default_fanout_load : 1.000000;
	default_leakage_power_density : 0.0;
	default_max_transition : 0.5;
	nom_voltage : 0.700000;
	nom_temperature : 125.000000;
	nom_process : 1.000000;
	library_features (report_power_calculation);
	library_features (report_noise_calculation);
	library_features("report_delay_calculation");
	default_wire_load_capacitance : 0.029396;
	default_wire_load_resistance : 0.002273;
	default_wire_load_area : 0.010000;
	default_wire_load_mode : "enclosed";
	driver_model : "snps_predriver";
	def_sim_opt : "POST=1 PROBE POST_VERSION=2001 INGOLD=2 NOMOD NOPAGE NUMDGT=10 MEASDGT=10 LIMPTS=500000 ICSWEEP=0 AUTOSTOP ALTCC=1 RUNLVL=5 ACCURATE=1 ABSVAR=1.000000e-03 RELVAR=1.000000e-02";
	simulator : "HSPICE -- C-2009.03-SP1 32-BIT (May 25 2009)";
	voltage_map("V",0.700000);
	voltage_map("VL",0.700000);
	voltage_map("VSS",0.000000);
