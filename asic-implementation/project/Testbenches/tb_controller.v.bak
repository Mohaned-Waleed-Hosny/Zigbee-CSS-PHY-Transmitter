`timescale 1ns / 1ps

module tb_controller;

    //DUT I/O
    reg         clk, reset, start_Tx, data_rate;
    reg  [7:0]  payload_len;

    wire [12:0] ram_read_addr;
    reg         i_ram_data, q_ram_data;

    wire [6:0]  rom_read_addr;
    reg         rom_data;

    wire        i_to_qpsk, q_to_qpsk, valid_to_qpsk, done_Tx;

    controller dut (
        .clk(clk), .reset(reset), .start_Tx(start_Tx),
        .data_rate(data_rate), .payload_len(payload_len),
        .ram_read_addr(ram_read_addr), .i_ram_data(i_ram_data), .q_ram_data(q_ram_data),
        .rom_read_addr(rom_read_addr), .rom_data(rom_data),
        .i_to_qpsk(i_to_qpsk), .q_to_qpsk(q_to_qpsk), .valid_to_qpsk(valid_to_qpsk),
        .done_Tx(done_Tx)
    );

    always #5 clk = ~clk;

    //Golden Preamble+SFD ROM content
    // SFD bit values: same convention/values used project-wide (form_ppdu.v),
    // -1 mapped to 0. Preamble is simply all-ones.
    reg sfd_1m   [0:15];
    reg sfd_250k [0:15];
    reg rom_mem  [0:127]; // max preamble(80) + SFD(16) = 96, sized with margin
    integer preamble_len, sfd_len, rom_len;

    //Synthetic RAM content (per I/Q path)
    reg i_ram_mem [0:8191];
    reg q_ram_mem [0:8191];

    integer k;

    //Scoreboard
    integer rom_cycle_cnt, ram_cycle_cnt, flush_cycle_cnt, done_cnt;
    integer exp_preamble_len, exp_sfd_len, exp_total_ram_bits;
    integer error_count, total_tests, failed_tests;
    integer test_idx;

    //Test-vector table
    // Includes edge cases (0 and 1 byte payload) and the max 127-byte
    // payload for both data rates, per the project's verification
    // requirements (edge-case coverage for payloadLength = 0, 1, 127).
    localparam NUM_TESTS = 8;
    reg       tc_rate       [0:NUM_TESTS-1];
    reg [7:0] tc_payload_len[0:NUM_TESTS-1];

    initial begin
        sfd_1m[0]=0; sfd_1m[1]=1; sfd_1m[2]=1; sfd_1m[3]=1; sfd_1m[4]=0; sfd_1m[5]=1; sfd_1m[6]=0; sfd_1m[7]=0;
        sfd_1m[8]=1; sfd_1m[9]=0; sfd_1m[10]=0; sfd_1m[11]=1; sfd_1m[12]=1; sfd_1m[13]=1; sfd_1m[14]=0; sfd_1m[15]=0;

        sfd_250k[0]=0; sfd_250k[1]=1; sfd_250k[2]=1; sfd_250k[3]=1; sfd_250k[4]=1; sfd_250k[5]=0; sfd_250k[6]=1; sfd_250k[7]=0;
        sfd_250k[8]=0; sfd_250k[9]=0; sfd_250k[10]=1; sfd_250k[11]=0; sfd_250k[12]=0; sfd_250k[13]=0; sfd_250k[14]=1; sfd_250k[15]=1;

        for (k = 0; k < 8192; k = k + 1) begin
            i_ram_mem[k] = k[0];
            q_ram_mem[k] = ~k[0];
        end

        tc_rate[0]=0; tc_payload_len[0]=0;    // 1 Mbps, empty payload
        tc_rate[1]=0; tc_payload_len[1]=1;    // 1 Mbps, 1 byte
        tc_rate[2]=0; tc_payload_len[2]=6;    // 1 Mbps, exact padding boundary
        tc_rate[3]=0; tc_payload_len[3]=127;  // 1 Mbps, max payload
        tc_rate[4]=1; tc_payload_len[4]=0;    // 250 kbps, empty payload
        tc_rate[5]=1; tc_payload_len[5]=1;    // 250 kbps, 1 byte
        tc_rate[6]=1; tc_payload_len[6]=24;   // 250 kbps, exact padding boundary
        tc_rate[7]=1; tc_payload_len[7]=127;  // 250 kbps, max payload
    end

    //Reference model (independent of controller.v RTL)
    task compute_expected;
        input       rate;
        input [7:0] plen;
        output integer preamble_o;
        output integer sfd_o;
        output integer total_ram_bits_o;
        integer raw_bits, pad, padded_bits, coded_total;
        begin
            sfd_o      = 16;
            preamble_o = rate ? 80 : 32;

            raw_bits = 12 + plen*8; // PHR (12 bits) + PSDU
            if (rate)
                pad = (raw_bits % 24 == 0) ? 0 : (24 (raw_bits % 24));
            else
                pad = (raw_bits % 6  == 0) ? 0 : (6  (raw_bits % 6));
            padded_bits = raw_bits + pad;

            if (rate)
                coded_total = (padded_bits / 6) * 32; // 250 kbps: n=6 -> m=32
            else
                coded_total = (padded_bits / 3) * 4;  // 1 Mbps:  n=3 -> m=4

            // Each I/Q buffer RAM holds HALF of the combined coded stream
            // (this is the property the total_ram_bits fix restores).
            total_ram_bits_o = coded_total / 2;
        end
    endtask

    task load_rom;
        input rate;
        integer p;
        begin
            preamble_len = rate ? 80 : 32;
            sfd_len      = 16;
            rom_len      = preamble_len + sfd_len;
            for (p = 0; p < preamble_len; p = p + 1)
                rom_mem[p] = 1'b1;
            for (p = 0; p < sfd_len; p = p + 1)
                rom_mem[preamble_len + p] = rate ? sfd_250k[p] : sfd_1m[p];
        end
    endtask

    // ROM/RAM behave combinationally, driven by the DUT's own addresses
    always @(*) begin
        rom_data   = rom_mem[rom_read_addr];
        i_ram_data = i_ram_mem[ram_read_addr];
        q_ram_data = q_ram_mem[ram_read_addr];
    end

    task run_test;
        input integer idx;
        integer cyc, rom_idx, ram_idx;
        reg     done_seen;
        integer local_errors;
        begin
            local_errors = 0;
            data_rate   = tc_rate[idx];
            payload_len = tc_payload_len[idx];

            load_rom(data_rate);
            compute_expected(data_rate, payload_len, exp_preamble_len, exp_sfd_len, exp_total_ram_bits);

            reset = 1; start_Tx = 0;
            @(posedge clk); @(posedge clk);
            reset = 0;
            @(posedge clk);

            start_Tx = 1;
            @(posedge clk);
            start_Tx = 0;

            rom_cycle_cnt = 0; ram_cycle_cnt = 0; flush_cycle_cnt = 0; done_cnt = 0;
            rom_idx = 0; ram_idx = 0;
            done_seen = 0;

            for (cyc = 0; cyc < (exp_preamble_len + exp_sfd_len + exp_total_ram_bits + 20); cyc = cyc + 1) begin
                @(posedge clk);
                if (valid_to_qpsk) begin
                    if (rom_cycle_cnt + ram_cycle_cnt < exp_preamble_len + exp_sfd_len) begin
                        // expect ROM phase (preamble/SFD)
                        if (i_to_qpsk !== rom_mem[rom_idx] || q_to_qpsk !== rom_mem[rom_idx]) begin
                            local_errors = local_errors + 1;
                            $display("[%0t] test %0d: ROM phase mismatch at idx %0d: i=%b q=%b exp=%b",
                                       $time, idx, rom_idx, i_to_qpsk, q_to_qpsk, rom_mem[rom_idx]);
                        end
                        rom_idx = rom_idx + 1;
                        rom_cycle_cnt = rom_cycle_cnt + 1;
                    end else begin
                        // expect RAM phase (PHR+PSDU)
                        if (i_to_qpsk !== i_ram_mem[ram_idx] || q_to_qpsk !== q_ram_mem[ram_idx]) begin
                            local_errors = local_errors + 1;
                            $display("[%0t] test %0d: RAM phase mismatch at idx %0d: i=%b(exp %b) q=%b(exp %b)",
                                       $time, idx, ram_idx, i_to_qpsk, i_ram_mem[ram_idx], q_to_qpsk, q_ram_mem[ram_idx]);
                        end
                        ram_idx = ram_idx + 1;
                        ram_cycle_cnt = ram_cycle_cnt + 1;
                    end
                end else if (!done_seen &&
                             (rom_cycle_cnt + ram_cycle_cnt >= exp_preamble_len + exp_sfd_len + exp_total_ram_bits)) begin
                    flush_cycle_cnt = flush_cycle_cnt + 1;
                end

                if (done_Tx) begin
                    done_cnt  = done_cnt + 1;
                    done_seen = 1;
                end
            end

            if (rom_cycle_cnt !== exp_preamble_len + exp_sfd_len) begin
                local_errors = local_errors + 1;
                $display("test %0d: preamble+SFD cycle count = %0d, expected %0d",
                           idx, rom_cycle_cnt, exp_preamble_len + exp_sfd_len);
            end
            if (ram_cycle_cnt !== exp_total_ram_bits) begin
                local_errors = local_errors + 1;
                $display("test %0d: TX_DATA cycle count = %0d, expected %0d",
                           idx, ram_cycle_cnt, exp_total_ram_bits);
            end
            if (flush_cycle_cnt !== 4) begin
                local_errors = local_errors + 1;
                $display("test %0d: FLUSH cycle count = %0d, expected 4", idx, flush_cycle_cnt);
            end
            if (done_cnt !== 1) begin
                local_errors = local_errors + 1;
                $display("test %0d: done_Tx pulse count = %0d, expected 1", idx, done_cnt);
            end

            if (local_errors == 0)
                $display("tb_controller: test %0d (rate=%0d, len=%0d) PASSED  (preamble+SFD=%0d, TX_DATA=%0d)",
                           idx, data_rate, payload_len, exp_preamble_len+exp_sfd_len, exp_total_ram_bits);
            else begin
                $display("tb_controller: test %0d (rate=%0d, len=%0d) FAILED with %0d error(s)",
                           idx, data_rate, payload_len, local_errors);
                failed_tests = failed_tests + 1;
            end
            error_count = error_count + local_errors;
        end
    endtask

    initial begin
        clk = 0; error_count = 0; failed_tests = 0; total_tests = NUM_TESTS;
        #1; // let the test-vector/ROM-content initial block finish populating first
        for (test_idx = 0; test_idx < NUM_TESTS; test_idx = test_idx + 1)
            run_test(test_idx);

        if (failed_tests == 0)
            $display("tb_controller: ALL %0d TESTS PASSED", total_tests);
        else
            $display("tb_controller: %0d / %0d TESTS FAILED", failed_tests, total_tests);

        $finish;
    end

endmodule